# ============================================================================
# Ghostty 配置文件（macOS · 精简最佳实践版）
# 路径：~/.config/ghostty/config
# 重载：Cmd+Shift+,（运行时；background-opacity 等少数项需重启）
#
# 设计原则（来自 Ghostty 官方）：
#   "零配置开箱即用。只显式写出你真正想偏离默认的项。"
#   官方明确反对把 `ghostty +show-config --default` 整段抄进配置文件，
#   因为部分默认值显式声明时会互相冲突。
#
# 完整选项查询：ghostty +show-config --default --docs
# 在线文档：    https://ghostty.org/docs/config/reference
# ============================================================================


# ----------------------------------------------------------------------------
# 字体
# ----------------------------------------------------------------------------

# 主字体。可重复 font-family 指定回退字体（缺字时按顺序回退）。
font-family = "Maple Mono NF CN"

# 字号（pt）。
font-size = 14

# 加粗描边（仅 macOS）。Maple Mono 字重已较饱满，关闭通常更清晰；
# 视网膜屏幕上字体偏淡时再开启。
# font-thicken = true

# 行距：在原始行高基础上增加 2 像素。
adjust-cell-height = 2


# ----------------------------------------------------------------------------
# 主题
# ----------------------------------------------------------------------------

# 单一主题。运行 `ghostty +list-themes` 查看所有内置主题。
# theme = Kanagawa Wave

# 若想跟随系统自动切换明暗，注释上一行，启用下一行：
theme = light:Kanagawa Lotus,dark:Kanagawa Wave


# ----------------------------------------------------------------------------
# 窗口外观
# ----------------------------------------------------------------------------

# 窗口内边距。
window-padding-x = 14
window-padding-y = 10

# 把窗口高度的剩余像素均匀分布到顶部和底部，而非全堆在底部。视觉更对称。
window-padding-balance = true

# macOS 标题栏样式：transparent / native / tabs / hidden。
# transparent 让标题栏融入背景色，整体更统一。
macos-titlebar-style = transparent

# 启动时初始窗口尺寸（单元格数=列×行）。15pt 字体下建议 120×36 起步；
# 80×24 是经典 VT100 尺寸，在现代显示器上偏小。
window-width = 120
window-height = 36

# 退出时保存窗口状态（位置、大小、标签等），下次启动恢复。
# 配合上面的 width/height 作为首次启动默认即可。
window-save-state = always


# ----------------------------------------------------------------------------
# 光标
# ----------------------------------------------------------------------------

# 光标样式：block / bar / underline / block_hollow。
cursor-style = block

# 注：cursor-style-blink 默认就是闪烁，无需显式设置。
# 如想禁用闪烁：cursor-style-blink = false


# ----------------------------------------------------------------------------
# 鼠标与选择
# ----------------------------------------------------------------------------

# 输入时自动隐藏鼠标光标，避免遮挡文本。
mouse-hide-while-typing = true

# 选中即复制到系统剪贴板（macOS 风格；与 tmux 配合很顺）。
copy-on-select = clipboard


# ----------------------------------------------------------------------------
# 可读性 / 对比度
# ----------------------------------------------------------------------------

# 强制前景与背景的最小对比度。1.1 防止出现"同色不可见文本"；
# 想要更鲜明可调到 3 以上（数值越高，对比越强，越接近纯黑/纯白）。
minimum-contrast = 1.1

# 非聚焦分屏的不透明度（默认 0.7）。0.85 让聚焦/非聚焦区分明显但不至于太暗。
unfocused-split-opacity = 0.85


# ----------------------------------------------------------------------------
# 关闭行为
# ----------------------------------------------------------------------------

# 关闭仍有进程运行的 surface 时弹窗确认。
# 强烈建议保持开启：避免误按 Cmd+W 干掉正在跑的 Claude Code / Codex。
# 若日常用 tmux 兜底（代理跑在 tmux 会话中），可以关闭。
confirm-close-surface = true


# ----------------------------------------------------------------------------
# 下拉终端（Quake 风格）
# ----------------------------------------------------------------------------

# 从屏幕哪个边缘滑出：top / bottom / left / right / center。
quick-terminal-position = top

# 出现在哪块屏幕：main / mouse / macos-menu-bar。
quick-terminal-screen = mouse

# 滑入/滑出动画时长（秒）。
quick-terminal-animation-duration = 0.15

# 注：quick-terminal-autohide 与 clipboard-paste-protection 都已是默认 true，无需写。


# ----------------------------------------------------------------------------
# Shell 集成
# ----------------------------------------------------------------------------

# 开启的子功能列表（默认全部开启；按需禁用）：
#   cursor        提示符自动切换光标形状
#   sudo          sudo 时保留 TERMINFO
#   title         自动改标签标题为"目录 — 命令"（区分跑 claude/codex 的标签很有用）
#   ssh-env       SSH 时传递终端环境变量
#   ssh-terminfo  SSH 时自动安装 Ghostty 的 terminfo
# 注：shell-integration = detect 是默认值，无需写。
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo


# ----------------------------------------------------------------------------
# macOS 专属
# ----------------------------------------------------------------------------

# 让左 Option 键作为 Alt，避免占用 macOS 的特殊字符输入。
# 这对 tmux、helix、Neovim 中的 Alt+ 键位至关重要。
macos-option-as-alt = left


# ----------------------------------------------------------------------------
# 性能
# ----------------------------------------------------------------------------

# 滚动回看缓冲区上限（字节）。25,000,000 ≈ 25MB，足够容纳很长的 AI 代理输出。
scrollback-limit = 25000000


# ============================================================================
# 快捷键
# ============================================================================
# 语法：keybind = trigger=action
# 前缀（可叠加）：global:（全局，仅 macOS）/ all:（所有 surface）
#                  unconsumed:（不消耗输入）/ performable:（仅动作可执行时消耗）
# 完整动作列表：https://ghostty.org/docs/config/keybind/reference
#
# 注意：以下大量 macOS 键位本就是 Ghostty 默认值（new_tab/close_surface/分屏等），
# 此处只显式列出"偏离默认"或"AI 代理工作流专用"的键位。
# 用 `ghostty +list-keybinds --default` 查看完整默认键位。
# ============================================================================


# ----------------------------------------------------------------------------
# AI 代理工作流（Claude Code / Codex）专用
# ----------------------------------------------------------------------------

# Shift+Enter 发送字面换行符。
# 默认情况下 Enter 会被 Claude Code / Codex 等 TUI 应用当作"提交"。
# 此键位让 Shift+Enter 在提示框中插入新行（编辑多行输入时极其有用）。
keybind = shift+enter=text:\n


# ----------------------------------------------------------------------------
# 标签页 / 分屏导航（偏离默认的部分）
# ----------------------------------------------------------------------------

# Ghostty 默认用 Cmd+Shift+[ / ] 切换标签。改成左右箭头更直觉。
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# 分屏间导航。注意方向只接受 left/right/up/down。
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# 分屏管理
# keybind = cmd+shift+e=equalize_splits         # 均衡所有分屏大小
# keybind = cmd+shift+f=toggle_split_zoom       # 缩放当前分屏（占满整个标签页）


# ----------------------------------------------------------------------------
# 字体大小
# ----------------------------------------------------------------------------

# macOS 上 "+" 的物理位置是 "=" 键 + Shift，trigger 用 cmd+equal。
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size


# ----------------------------------------------------------------------------
# 其他
# ----------------------------------------------------------------------------

# 全局唤出下拉终端（即使 Ghostty 未聚焦也生效）。
# 首次使用需在 系统设置 → 隐私与安全性 → 辅助功能 中授予 Ghostty 权限。
keybind = global:ctrl+`=toggle_quick_terminal
