# =========================
# Zsh 配置（macOS 开发环境优化版）
# =========================

# Homebrew 应在 ~/.zprofile 中初始化：
# eval "$(/opt/homebrew/bin/brew shellenv)"

# =========================
# Oh My Zsh
# =========================
export ZSH="$HOME/.oh-my-zsh"

# 使用 Starship 作为提示符，关闭 Oh My Zsh 主题避免冲突。
ZSH_THEME=""

# git 插件足够轻量，其他补全和高亮后续可交给 zinit 管理。
plugins=(git)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# =========================
# 基础环境
# =========================
# 默认沿用系统 locale；需要固定语言时在 ~/.zshrc.local 中设置。
export EDITOR="code --wait"
export VISUAL="$EDITOR"
export PAGER="less -R"
export LESS="-R -i -M"

# Homebrew 镜像、公司代理和地区网络差异建议放 ~/.zshrc.local 或 ~/.zprofile。
if [[ -n "${MACOS_DEV_SETUP_HOMEBREW_BOTTLE_DOMAIN:-}" ]]; then
  export HOMEBREW_BOTTLE_DOMAIN="$MACOS_DEV_SETUP_HOMEBREW_BOTTLE_DOMAIN"
fi

# 优先使用 Homebrew curl。
[[ -d "/opt/homebrew/opt/curl/bin" ]] && export PATH="/opt/homebrew/opt/curl/bin:$PATH"

# =========================
# 代理控制
# =========================
proxy_on() {
  if [[ -z "${MACOS_DEV_SETUP_HTTP_PROXY:-}" && -z "${MACOS_DEV_SETUP_HTTPS_PROXY:-}" && -z "${MACOS_DEV_SETUP_ALL_PROXY:-}" ]]; then
    echo "未配置代理。请在 ~/.zshrc.local 中设置 MACOS_DEV_SETUP_HTTP_PROXY / MACOS_DEV_SETUP_ALL_PROXY。"
    return 1
  fi
  local http="${MACOS_DEV_SETUP_HTTP_PROXY:-}"
  local https="${MACOS_DEV_SETUP_HTTPS_PROXY:-$http}"
  local socks="${MACOS_DEV_SETUP_ALL_PROXY:-}"
  [[ -n "$http" ]] && export http_proxy="$http"
  [[ -n "$https" ]] && export https_proxy="$https"
  [[ -n "$socks" ]] && export all_proxy="$socks"
  echo "代理已开启：http=${http_proxy:-未设置} https=${https_proxy:-未设置} all=${all_proxy:-未设置}"
}

proxy_off() {
  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
  echo "代理已关闭"
}

proxy_status() {
  echo "http_proxy=${http_proxy:-未设置}"
  echo "https_proxy=${https_proxy:-未设置}"
  echo "all_proxy=${all_proxy:-未设置}"
}

# =========================
# SDKMAN (Java / Maven / Gradle)
# =========================
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# =========================
# fnm (Node.js)
# =========================
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# =========================
# pyenv (Python)
# =========================
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi

# =========================
# bun
# =========================
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"

# =========================
# Rust
# =========================
[[ -s "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# =========================
# 本地工具路径
# =========================
[[ -d "$HOME/.lmstudio/bin" ]] && export PATH="$PATH:$HOME/.lmstudio/bin"
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# =========================
# 本机私有配置
# =========================
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# =========================
# 常用别名
# =========================
command -v eza >/dev/null 2>&1 && alias ls='eza --group-directories-first'
command -v eza >/dev/null 2>&1 && alias ll='eza -l --git --icons --group-directories-first'
command -v eza >/dev/null 2>&1 && alias la='eza -la --git --icons --group-directories-first'
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v rg >/dev/null 2>&1 && alias grep='rg'
command -v fd >/dev/null 2>&1 && alias find='fd'
alias g='git'
alias t='tmux'
alias ta='tmux attach -t'
alias tl='tmux ls'

# =========================
# Starship
# =========================
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# =========================
# Zinit (Homebrew)
# =========================
if [[ -s "/opt/homebrew/opt/zinit/zinit.zsh" ]]; then
  source "/opt/homebrew/opt/zinit/zinit.zsh"
fi
